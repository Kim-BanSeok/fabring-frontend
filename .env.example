# Browser request prefix. With Vite this is forwarded to API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Backend repository default development port. No credentials belong here.
API_PROXY_TARGET=http://127.0.0.1:3000

# A deployed frontend needs its own /api reverse proxy or a real API URL:
# VITE_API_BASE_URL=https://YOUR_API_HOST/api/v1
# For cross-origin requests, the backend CORS_ORIGIN must include the frontend origin.
